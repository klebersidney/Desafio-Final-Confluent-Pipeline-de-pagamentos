# ─── Confluent Cloud ──────────────────────────────────────────────────────────
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# ─── Environment / Cluster (preenchidos pelo setup.sh, ou informe manualmente)
ENVIRONMENT_ID=
CLUSTER_ID=
BOOTSTRAP_SERVER=

# ─── Schema Registry ─────────────────────────────────────────────────────────
SR_URL=
SR_API_KEY=
SR_API_SECRET=

# ─── Service Accounts (preenchidos pelo setup.sh)
SA_PRODUCER_ID=
SA_PRODUCER_API_KEY=
SA_PRODUCER_API_SECRET=
SA_CONSUMER_ID=
SA_CONSUMER_API_KEY=
SA_CONSUMER_API_SECRET=

# ─── Neon (Postgres) ─────────────────────────────────────────────────────────
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=cdc_user
PG_PASSWORD=
PG_SSLMODE=require

# ─── CDC Connector ───────────────────────────────────────────────────────────
CDC_PASSWORD=
